{
  "name": "manager-of-champions",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @moc/web",
    "build": "npm run build -w @moc/web",
    "typecheck": "tsc -p packages/engine && tsc -p packages/harness && tsc -p packages/pipeline && tsc -p apps/web",
    "test": "vitest run",
    "calibrate": "node packages/harness/src/calibrate.ts --seasons 25",
    "check": "npm run typecheck && npm test && npm run calibrate -- --check",
    "data:england": "node packages/pipeline/src/build-england.ts",
    "data:scotland": "node packages/pipeline/src/build-scotland.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
